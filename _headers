/admin
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
/api/*
  Cache-Control: no-store
/onizleme/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet
  Referrer-Policy: no-referrer
  Cache-Control: no-cache

/assets/ts/*
  Cache-Control: public, max-age=2592000

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: geolocation=(), microphone=(), camera=(), browsing-topics=()

# Pages önizleme ve .pages.dev kopyaları dizine girmesin — ikiz içerik olurlar.
# (Ara katman da aynı başlığı basar; bu satırlar ikinci emniyet.)
https://:proje.pages.dev/*
  X-Robots-Tag: noindex, nofollow
https://:dal.:proje.pages.dev/*
  X-Robots-Tag: noindex, nofollow
